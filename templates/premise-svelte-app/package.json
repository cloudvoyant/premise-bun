{
  "name": "premise-svelte-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist coverage",
    "test": "bun test",
    "lint": "svelte-check --tsconfig ./tsconfig.json",
    "lint:fix": "bun run format && bun run lint",
    "format": "prettier --plugin=prettier-plugin-svelte --write .",
    "format:check": "prettier --plugin=prettier-plugin-svelte --check .",
    "dev": "vite",
    "start": "vite preview"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/bun": "1.4.2",
    "prettier": "3.9.8",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
