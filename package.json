{
  "name": "premise-bun",
  "private": true,
  "description": "Monorepo root for the @cloudvoyant scope",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "bun run --filter premise-bun build",
    "test": "bun run --filter premise-bun test",
    "lint": "bun run --filter premise-bun lint",
    "lint:fix": "bun run --filter premise-bun lint:fix",
    "format": "bun run --filter premise-bun format",
    "format:check": "bun run --filter premise-bun format:check"
  }
}
